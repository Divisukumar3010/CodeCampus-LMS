# ==============================================================================
# CodeCampus LMS - Frontend Environment Variables
# ==============================================================================

# Backend API Root URL
VITE_API_URL=http://localhost:5000/api

# Stripe Public Key (Publishable Key from stripe.com/dashboard)
VITE_STRIPE_PUBLISHABLE_KEY=

# Google Client ID (Public client ID from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=

# Microsoft Client ID (Application / Client ID from Microsoft Azure Portal)
VITE_MICROSOFT_CLIENT_ID=